# Copy to .env for local dev (never commit the real .env — it's gitignored).
# On Render, set these in the service's Environment tab instead of a file.

# xAI console: https://console.x.ai
GROK_API_KEY=

# Optional — defaults to grok-4-fast if unset.
GROK_MODEL=grok-4-fast

# Render Postgres connection string. Locally use the database's External
# Database URL (Connect tab); on Render itself use the Internal Database URL
# so traffic stays on the private network. All app tables live in the
# `forge` schema — this instance is shared with other apps in their own
# schemas, so never run anything here outside `forge.*`.
DATABASE_URL=
